@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using System.Globalization
@using System.Diagnostics
@using System.Text.Json
@using DecisionApps.Contracts
@inject SimulatorApiClient Api
@inject IJSRuntime JS
@inject ILogger<Home> Logger

<PageTitle>Decision Lab | Simulatore agenti</PageTitle>

@{
    var evaluation = RoutingEvaluation.Summarize(EvaluationRows);
    var listRows = SheetQuestions.Concat(manualEntries).Select(ToEvaluationRow).ToArray();
    var filteredCount = listRows.Count(row => row.MatchesFilter(resultFilter));
}

<section class="intro">
    <div>
        <div class="eyebrow">MICROSOFT DECISION 1.1</div>
        <h1>La domanda giusta.<br /><span>All'agente giusto.</span></h1>
        <p>Esplora come Decision distribuisce le richieste dei cittadini.<br />
            Importa le domande, avvia il test e confronta le probabilita di routing.</p>
    </div>
    <div class="model-card">
        <div class="model-icon">01</div>
        <div><span class="muted small">MODELLO DI CLASSIFICAZIONE</span><strong>@(configuration?.Model ?? "Decision-1.1")</strong>
            <span class="small">@(configuration?.Authentication ?? "Connessione API in corso...")</span></div>
    </div>
</section>

@if (error is not null)
{
    <div class="notice error" role="alert">@error</div>
}

<div class="workspace">
    <aside class="control-column">
        <section class="panel">
            <div class="section-title"><span class="step-number">01</span><h2>Prepara le domande</h2></div>
            <p class="muted small">Carica un Excel con la colonna <strong>DOMANDE</strong> o <strong>DOMANDA</strong>.</p>
            <label class="upload-zone">
                <span class="upload-icon" aria-hidden="true">+</span>
                <strong>@(importing ? "Importazione in corso..." : "Scegli un file Excel")</strong>
                <span class="muted small">.xlsx &middot; massimo 10 MB</span>
                <InputFile OnChange="ImportAsync" accept=".xlsx" disabled="@(busy || importing || !ready)" aria-label="Carica file Excel" />
            </label>
            @if (imported is not null)
            {
                <div class="file-info"><strong>@imported.FileName</strong><span>@imported.Questions.Count domande importate</span></div>
                <label class="field-label" for="sheet">Foglio di lavoro</label>
                <select id="sheet" @bind="sheet" @bind:after="ChangeSheet" disabled="@busy">
                    @foreach (var group in imported.Questions.GroupBy(q => q.Sheet))
                    {
                        <option value="@group.Key">@group.Key (@group.Count())</option>
                    }
                </select>
                <div class="button-row compact">
                    <button class="text-button" @onclick="SelectSheet" disabled="@busy">Seleziona foglio</button>
                    <button class="text-button" @onclick="ClearSelection" disabled="@busy">Deseleziona tutto</button>
                </div>
                <button class="secondary full-width" @onclick="SelectAllQuestions" disabled="@busy">
                    Seleziona tutte le domande (@imported.Questions.Count)
                </button>
                <details class="scope-reference">
                    <summary>Mappa ambiti Excel (@imported.Questions.Select(q => q.Scope).Distinct().Count())</summary>
                    <p class="muted small">Agente atteso dalla mappa confermata sulle card. Priorita a Foglio origine, non al sotto-tema Ambito.</p>
                    @foreach (var group in imported.Questions.GroupBy(q => new { q.Scope, q.ExpectedAgent }))
                    {
                        <div class="scope-mapping">
                            <span>@(group.Key.Scope ?? "Ambito assente") <small>(@group.Count())</small></span>
                            <strong>@(group.Key.ExpectedAgent is { } expected ? ShortName(expected) : "Non mappato")</strong>
                        </div>
                    }
                </details>
                @if (imported.Questions.Count(q => q.ExpectedAgent is null) is > 0 and var unmapped)
                {
                    <p class="reference-warning" role="status">@unmapped domande senza agente atteso: ambito assente o non mappato. Saranno escluse dalla percentuale di corrispondenza.</p>
                }
            }
            <div class="divider"><span>oppure prova una domanda</span></div>
            <label class="field-label" for="question">Richiesta del cittadino</label>
            <textarea id="question" @bind="manualQuestion" @bind:event="oninput" disabled="@busy"
                maxlength="@SimulatorLimits.MaxQuestionLength" rows="4" placeholder="Es. Vorrei richiedere un certificato di residenza"></textarea>
            <button class="secondary full-width" @onclick="RateManualAsync"
                disabled="@(busy || importing || !ready || string.IsNullOrWhiteSpace(manualQuestion))">Analizza domanda singola</button>
        </section>

        <section class="panel agents-panel">
            <div class="section-title"><span class="step-number">02</span><h2>Gli agenti in campo</h2></div>
            <p class="muted small">Competenze definite dalle card A2A fornite.</p>
            @foreach (var agent in agents)
            {
                <details class="agent-detail">
                    <summary><span class="agent-avatar @agent.Id">@ShortName(agent.Id)[..1]</span>
                        <span>@ShortName(agent.Id)</span><span class="detail-plus">+</span></summary>
                    <p>@agent.Description</p>
                </details>
            }
        </section>
        <div class="privacy-note">Le domande selezionate sono inviate al tuo endpoint Foundry solo all'avvio del test. Nessun file o risultato viene salvato dal server.</div>
    </aside>

    <section class="results-column">
        <div class="metrics">
            <div class="metric"><span>DOMANDE NEL FOGLIO</span><strong>@SheetQuestions.Count()</strong></div>
            <div class="metric"><span>ANALIZZATE</span><strong>@entries.Values.Count(e => e.Result is not null)</strong></div>
            <div class="metric"><span>DA RIVEDERE</span><strong class="amber">@entries.Values.Count(e => e.Result?.NeedsReview == true)</strong></div>
            <div class="metric"><span>ERRORI</span><strong>@entries.Values.Count(e => e.Error is not null)</strong></div>
        </div>

        <section class="panel evaluation-panel" aria-label="Confronto con Excel">
            <div class="results-toolbar">
                <div><div class="eyebrow">CONFRONTO CON EXCEL</div><h2>Decision vs agente atteso</h2></div>
                <div class="match-rate">
                    <strong>@(evaluation.MatchPercentage is { } percentage ? $"{percentage:F2}%" : "--")</strong>
                    <span>corrispondenza</span>
                </div>
            </div>
            <div class="evaluation-counts" role="status">
                <span><strong>@evaluation.Matches</strong> corrispondono</span>
                <span><strong>@evaluation.Mismatches</strong> non corrispondono</span>
                <span><strong>@evaluation.Compared</strong> confrontate</span>
                <span><strong>@evaluation.NotComparable</strong> non confrontabili</span>
            </div>
            <p class="evaluation-note">Totali su tutti i fogli e test singoli. Percentuale = corrispondenze / classificazioni con agente atteso.
                In attesa (@evaluation.Pending), errori (@evaluation.Errors) e risultati senza ambito mappato sono esclusi.
                L'ambito non viene inviato a Decision. Una differenza indica disaccordo con la mappa, non necessariamente un errore del modello.</p>
            @if (EvaluationRows.Any(row => row.Result is not null))
            {
                <details class="scope-breakdown">
                    <summary>Dettaglio per ambito</summary>
                    <div class="table-scroll">
                        <table>
                            <thead><tr><th>Ambito Excel</th><th>Agente atteso</th><th>Corrisponde</th><th>Non corrisponde</th><th>Non confrontabili</th><th>Corrispondenza</th></tr></thead>
                            <tbody>
                                @foreach (var group in EvaluationRows.Where(row => row.Result is not null)
                                    .GroupBy(row => new { row.Question.Scope, row.Question.ExpectedAgent }))
                                {
                                    var summary = RoutingEvaluation.Summarize(group);
                                    <tr>
                                        <td>@(group.Key.Scope ?? "Senza ambito / test singolo")</td>
                                        <td>@(group.Key.ExpectedAgent is { } expected ? ShortName(expected) : "--")</td>
                                        <td>@summary.Matches</td><td>@summary.Mismatches</td><td>@summary.NotComparable</td>
                                        <td>@(summary.MatchPercentage is { } rate ? $"{rate:F2}%" : "--")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            }
        </section>

        <section class="panel results-panel">
            <div class="results-toolbar">
                <div><div class="eyebrow">SIMULATORE</div><h2>Risultati di classificazione</h2></div>
                <button class="secondary" @onclick="ExportAsync" disabled="@(!entries.Values.Any(e => e.Result is not null || e.Error is not null))">Esporta JSON</button>
            </div>
            <div class="run-bar">
                <div><strong>@selected.Count domande selezionate</strong><span class="muted small">Una chiamata Decision per domanda, senza retry automatici.</span></div>
                @if (busy)
                {
                    <button class="stop-button" @onclick="Cancel">Interrompi test</button>
                }
                else
                {
                    <button class="primary" @onclick="RunSelectedAsync" disabled="@(importing || !ready || selected.Count == 0)">Avvia test (@selected.Count)</button>
                }
            </div>
            @if (runTotal > 0)
            {
                <div class="progress-label" role="status">@runMessage <strong>@runCompleted / @runTotal</strong></div>
                <progress value="@runCompleted" max="@runTotal" aria-label="Avanzamento test"></progress>
                <section class="execution-metrics" aria-label="Consumi e tempo di esecuzione">
                    <div class="execution-metrics-heading">@(busy ? "ESECUZIONE IN CORSO" : "ULTIMA ESECUZIONE")</div>
                    <div class="metrics">
                        <div class="metric"><span>TOKEN INPUT</span><strong>@(runUsage.ReportedResponses > 0 ? runUsage.InputTokens.ToString("N0") : "--")</strong></div>
                        <div class="metric"><span>TOKEN OUTPUT</span><strong>@(runUsage.ReportedResponses > 0 ? runUsage.OutputTokens.ToString("N0") : "--")</strong></div>
                        <div class="metric"><span>TOKEN TOTALI</span><strong>@(runUsage.ReportedResponses > 0 ? runUsage.TotalTokens.ToString("N0") : "--")</strong></div>
                        <div class="metric"><span>TEMPO TOTALE MODELLO</span><strong class="elapsed-time">@(runUsage.TimedResponses > 0 ? FormatDuration(runUsage.ModelElapsedMilliseconds) : "--")</strong></div>
                    </div>
                    <p class="execution-note">
                        Consumi comunicati da Decision in questa esecuzione: @runUsage.ReportedResponses risposte con conteggio,
                        @runUsage.MissingUsageResponses senza conteggio.
                        Il tempo somma solo le chiamate HTTP a Decision misurate (@runUsage.TimedResponses), rete e gateway inclusi.
                        Esclude autenticazione, elaborazione API e UI; si aggiorna al termine di ogni chiamata.
                        Richieste annullate o senza misura non entrano nella somma. Errori o richieste annullate possono aver consumato token non rendicontati.
                    </p>
                </section>
            }
            <div class="probability-note">Classificazione esclusiva: i cinque punteggi agente sommano al 100%. Il modello non genera motivazioni testuali.</div>

            @if (listRows.Length > 0)
            {
                <section class="results-filter" aria-label="Filtri risultati">
                    <div class="results-filter-field">
                        <label class="field-label" for="result-filter">Filtra risultati</label>
                        <select id="result-filter" @bind="resultFilter" @bind:after="ChangeResultFilter">
                            <option value="@EvaluationFilter.All">Tutte (@listRows.Length)</option>
                            <option value="@EvaluationFilter.NeedsReview">Da rivedere (@listRows.Count(row => row.MatchesFilter(EvaluationFilter.NeedsReview)))</option>
                            <option value="@EvaluationFilter.ScopeMismatch">Non corrisponde all'ambito (@listRows.Count(row => row.MatchesFilter(EvaluationFilter.ScopeMismatch)))</option>
                        </select>
                    </div>
                    <span class="filter-count" role="status">@filteredCount di @listRows.Length domande nel filtro</span>
                    <p class="filter-note">Filtro sul foglio corrente e sui test singoli, applicato a tutte le pagine.
                        Selezione, riepiloghi ed export restano invariati: le domande nascoste possono restare selezionate.
                        "Seleziona foglio" include anche le righe nascoste.</p>
                </section>
            }

            @if (!SheetQuestions.Any() && manualEntries.Count == 0)
            {
                <div class="empty-state"><div class="empty-art" aria-hidden="true"><span>?</span><i></i><b>01</b></div>
                    <h3>Ogni domanda ha una destinazione.</h3>
                    <p>Carica il tuo set di domande o scrivi una richiesta.<br />Qui vedrai agenti, probabilita e azione proposta.</p>
                    <span class="empty-badge">5 AGENTI &nbsp; / &nbsp; 2 TIPI DI AZIONE</span>
                </div>
            }
            else if (filteredCount == 0)
            {
                <div class="filter-empty" role="status">
                    <h3>Nessuna domanda corrisponde al filtro.</h3>
                    <p>@(resultFilter == EvaluationFilter.NeedsReview
                        ? "Nessun risultato gia classificato e contrassegnato come da rivedere."
                        : "Le righe in attesa, gli errori e i risultati non confrontabili non sono differenze di ambito.")</p>
                    <button class="text-button" @onclick="ClearResultFilter">Mostra tutte</button>
                </div>
            }
            else
            {
                <div class="question-list">
                    @foreach (var question in VisibleQuestions.Concat(FilteredManualEntries))
                    {
                        var entry = entries.GetValueOrDefault(question.Id);
                        <article class="question-card" @key="question.Id">
                            <div class="question-heading">
                                @if (question.Id > 0)
                                {
                                    <input type="checkbox" checked="@selected.Contains(question.Id)" disabled="@busy"
                                        @onchange="args => Toggle(question.Id, args.Value is true)"
                                        aria-label="@($"Seleziona riga {question.Row}")" />
                                }
                                <span class="question-source">@(question.Id < 0 ? "TEST SINGOLO" : $"{question.Sheet} / RIGA {question.Row}")</span>
                                @if (activeId == question.Id)
                                {
                                    <span class="badge processing" role="status">Analisi in corso...</span>
                                }
                                else if (entry?.Result is { } rated)
                                {
                                    <span class="badge @(rated.NeedsReview ? "review" : "completed")">@(rated.NeedsReview ? "Da rivedere" : "Classificata")</span>
                                }
                                else if (entry?.Error is not null)
                                {
                                    <span class="badge failed">Errore</span>
                                }
                                else
                                {
                                    <span class="badge pending">In attesa</span>
                                }
                            </div>
                            <h3>@question.Question</h3>
                            @if (question.Id > 0)
                            {
                                <div class="reference-summary">
                                    <span>Ambito Excel <strong>@(question.Scope ?? "Assente")</strong></span>
                                    <span>Agente atteso <strong>@(question.ExpectedAgent is { } expected ? ShortName(expected) : "Non disponibile")</strong></span>
                                    @if (question.ScopeSource is not null)
                                    {
                                        <span>Fonte: @question.ScopeSource</span>
                                    }
                                </div>
                            }
                            @if (entry?.Result is { } result)
                            {
                                var comparison = RoutingEvaluation.Compare(question, result);
                                <div class="comparison-result @(comparison.Matches switch { true => "match", false => "mismatch", _ => "not-comparable" })">
                                    @if (comparison.Matches is { } matches)
                                    {
                                        <strong>@(matches ? "Corrisponde all'ambito Excel" : "Non corrisponde all'ambito Excel")</strong>
                                        <span>Atteso: @ShortName(question.ExpectedAgent!) / Decision: @ShortName(result.SelectedAgent)</span>
                                    }
                                    else
                                    {
                                        <strong>Non confrontabile</strong>
                                        <span>Agente atteso assente: @(question.Scope is null ? "nessun ambito Excel" : "ambito non mappato").</span>
                                    }
                                </div>
                                <div class="rating-bars">
                                    @foreach (var rating in result.Agents)
                                    {
                                        <div class="rating-line">
                                            <span class="rating-name">@ShortName(rating.Id)</span>
                                            <div class="bar-track"><div class="bar-fill @rating.Id" style="@($"width:{rating.Percentage.ToString(CultureInfo.InvariantCulture)}%")"></div></div>
                                            <strong>@rating.Percentage.ToString("F2")%</strong>
                                        </div>
                                    }
                                </div>
                                <div class="decision-summary">
                                    <span>Destinatario <strong>@ShortName(result.SelectedAgent)</strong></span>
                                    <span>Azione proposta <strong class="action-label">@result.SelectedAction</strong></span>
                                    <span class="muted">Chiamata modello: @FormatDuration(result.ElapsedMilliseconds)</span>
                                </div>
                                <div class="token-summary">
                                    @if (result.Usage is { } usage)
                                    {
                                        <span>Token input <strong>@usage.InputTokens.ToString("N0")</strong></span>
                                        <span>Token output <strong>@usage.OutputTokens.ToString("N0")</strong></span>
                                        <span>Token totali <strong>@usage.TotalTokens.ToString("N0")</strong></span>
                                    }
                                    else
                                    {
                                        <span>Consumo token non disponibile nella risposta di Decision.</span>
                                    }
                                </div>
                                <details class="action-details" open><summary>Probabilita delle azioni</summary>
                                    @foreach (var action in result.Actions)
                                    {
                                        <span>@action.Name: <strong>@action.Percentage.ToString("F2")%</strong> &nbsp;</span>
                                    }
                                </details>
                                @if (result.NeedsReview)
                                {
                                    <p class="review-note">Confidenza inferiore al 60% o distacco tra i primi agenti inferiore a 10 punti: verificare manualmente.</p>
                                }
                            }
                            @if (entry?.Error is not null)
                            {
                                <p class="row-error" role="alert">@entry.Error</p>
                                @if (entry.ModelElapsedMilliseconds is { } elapsed)
                                {
                                    <p class="muted small">Chiamata modello: @FormatDuration(elapsed)</p>
                                }
                            }
                        </article>
                    }
                </div>
                @if (TotalPages > 1)
                {
                    <div class="pagination">
                        <button class="secondary" @onclick="PreviousPage" disabled="@(page == 0)">Precedente</button>
                        <span>Pagina @(page + 1) di @TotalPages</span>
                        <button class="secondary" @onclick="NextPage" disabled="@(page + 1 >= TotalPages)">Successiva</button>
                    </div>
                }
            }
        </section>
        <p class="simulation-note"><strong>Ambiente dimostrativo.</strong> Le probabilita esprimono una scelta relativa tra i cinque agenti, non garantiscono la correttezza o la fattibilita della richiesta. Nessuna operazione viene eseguita.</p>
    </section>
</div>

@code {
    private static readonly ActivitySource ActivitySource = new("DecisionApps.Web");
    private readonly CancellationTokenSource lifetime = new();
    private CancellationTokenSource? runCancellation;
    private AgentCard[] agents = [];
    private ModelConfiguration? configuration;
    private ImportResult? imported;
    private readonly HashSet<int> selected = [];
    private readonly Dictionary<int, Entry> entries = [];
    private readonly List<ImportedQuestion> manualEntries = [];
    private string? sheet;
    private string manualQuestion = "";
    private string? error;
    private bool ready;
    private bool busy;
    private bool importing;
    private int? activeId;
    private int manualId;
    private int page;
    private EvaluationFilter resultFilter;
    private int runTotal;
    private int runCompleted;
    private string runMessage = "";
    private ExecutionUsage runUsage = new();
    private const int PageSize = 20;
    private IEnumerable<ImportedQuestion> SheetQuestions => imported?.Questions.Where(q => q.Sheet == sheet) ?? [];
    private IEnumerable<ImportedQuestion> FilteredSheetQuestions =>
        SheetQuestions.Where(question => ToEvaluationRow(question).MatchesFilter(resultFilter));
    private IEnumerable<ImportedQuestion> FilteredManualEntries =>
        manualEntries.Where(question => ToEvaluationRow(question).MatchesFilter(resultFilter));
    private IEnumerable<ImportedQuestion> VisibleQuestions => FilteredSheetQuestions.Skip(page * PageSize).Take(PageSize);
    private int TotalPages => (FilteredSheetQuestions.Count() + PageSize - 1) / PageSize;
    private IEnumerable<EvaluationRow> EvaluationRows =>
        (imported?.Questions ?? []).Concat(manualEntries).Select(ToEvaluationRow);

    private EvaluationRow ToEvaluationRow(ImportedQuestion question)
    {
        var entry = entries.GetValueOrDefault(question.Id);
        return new EvaluationRow(question, entry?.Result, entry?.Error);
    }

    private void SetEntry(int id, Entry entry)
    {
        entries[id] = entry;
        page = Math.Clamp(page, 0, Math.Max(0, TotalPages - 1));
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            agents = await Api.GetAgentsAsync(lifetime.Token);
            configuration = await Api.GetConfigurationAsync(lifetime.Token);
            ready = true;
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            ShowError(ex);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        error = null;
        importing = true;
        try
        {
            if (args.File.Size > SimulatorLimits.MaxFileBytes)
            {
                throw new SimulatorApiException("Il file supera il limite di 10 MB.", 413);
            }
            await using var stream = args.File.OpenReadStream(SimulatorLimits.MaxFileBytes, lifetime.Token);
            var result = await Api.ImportAsync(stream, args.File.Name, lifetime.Token);
            imported = result;
            sheet = result.Questions[0].Sheet;
            selected.Clear();
            entries.Clear();
            manualEntries.Clear();
            page = 0;
            resultFilter = EvaluationFilter.All;
            runTotal = 0;
            runUsage = new();
        }
        catch (Exception ex) when (IsExpected(ex)) { ShowError(ex); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        finally { importing = false; }
    }

    private void ChangeSheet() => page = 0;
    private void ChangeResultFilter() => page = 0;
    private void ClearResultFilter() { resultFilter = EvaluationFilter.All; page = 0; }
    private void SelectSheet() { foreach (var question in SheetQuestions) selected.Add(question.Id); }
    private void SelectAllQuestions() => selected.UnionWith(imported!.Questions.Select(question => question.Id));
    private void ClearSelection() => selected.Clear();
    private void Toggle(int id, bool value) { if (value) selected.Add(id); else selected.Remove(id); }
    private void PreviousPage() => page--;
    private void NextPage() => page++;
    private void Cancel() => runCancellation?.Cancel();

    private Task RunSelectedAsync() => RunAsync(imported!.Questions.Where(q => selected.Contains(q.Id)).ToArray());

    private Task RateManualAsync()
    {
        var question = new ImportedQuestion(--manualId, "Manuale", 0, manualQuestion.Trim());
        manualEntries.Insert(0, question);
        return RunAsync([question]);
    }

    private async Task RunAsync(IReadOnlyList<ImportedQuestion> questions)
    {
        using var activity = ActivitySource.StartActivity("simulator.run");
        activity?.SetTag("decision.questions.requested", questions.Count);
        var failed = 0;
        busy = true;
        error = null;
        runTotal = questions.Count;
        runCompleted = 0;
        runMessage = "Test in corso";
        runUsage = new();
        runCancellation = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
        try
        {
            foreach (var question in questions)
            {
                runCancellation.Token.ThrowIfCancellationRequested();
                activeId = question.Id;
                await InvokeAsync(StateHasChanged);
                try
                {
                    var result = await Api.RateAsync(question.Question, runCancellation.Token);
                    runUsage.Add(result.Usage);
                    runUsage.AddModelDuration(result.ElapsedMilliseconds);
                    SetEntry(question.Id, new Entry(result, null));
                }
                catch (SimulatorApiException ex)
                {
                    failed++;
                    activity?.SetStatus(ActivityStatusCode.Error);
                    activity?.SetTag("error.type", ex.StatusCode.ToString(CultureInfo.InvariantCulture));
                    if (ex.ModelElapsedMilliseconds is { } elapsed)
                    {
                        runUsage.AddModelDuration(elapsed);
                    }
                    SetEntry(question.Id, new Entry(null, ex.Message, ex.ModelElapsedMilliseconds));
                    Logger.LogWarning("Classificazione non disponibile: HTTP {StatusCode}", ex.StatusCode);
                    runCompleted++;
                    if (ex.StatusCode is 429 or 502 or 503 or 504)
                    {
                        runMessage = "Test fermato per errore del servizio";
                        error = ex.Message;
                        break;
                    }
                    continue;
                }
                runCompleted++;
            }
            if (runCompleted == runTotal) runMessage = "Test terminato";
        }
        catch (OperationCanceledException) when (runCancellation.IsCancellationRequested)
        {
            activity?.SetTag("decision.cancelled", true);
            runMessage = "Test interrotto. Risultati gia ricevuti conservati.";
        }
        catch (Exception ex) when (IsExpected(ex))
        {
            failed++;
            activity?.SetStatus(ActivityStatusCode.Error);
            activity?.SetTag("error.type", ex.GetType().FullName);
            ShowError(ex);
            if (activeId is { } id) SetEntry(id, new Entry(null, error));
            runMessage = "Test fermato";
        }
        finally
        {
            activity?.SetTag("decision.questions.completed", runCompleted);
            activity?.SetTag("decision.questions.failed", failed);
            activity?.SetTag("gen_ai.usage.input_tokens", runUsage.ReportedResponses > 0 ? runUsage.InputTokens : null);
            activity?.SetTag("gen_ai.usage.output_tokens", runUsage.ReportedResponses > 0 ? runUsage.OutputTokens : null);
            activity?.SetTag("decision.responses.without_usage", runUsage.MissingUsageResponses);
            activity?.SetTag("decision.model.elapsed_ms", runUsage.TimedResponses > 0 ? runUsage.ModelElapsedMilliseconds : null);
            activity?.SetTag("decision.model.timed_responses", runUsage.TimedResponses);
            activeId = null;
            busy = false;
            runCancellation.Dispose();
            runCancellation = null;
        }
    }

    private static string FormatDuration(long elapsedMilliseconds)
    {
        var elapsed = TimeSpan.FromMilliseconds(elapsedMilliseconds);
        return $"{(long)elapsed.TotalHours:00}:{elapsed.Minutes:00}:{elapsed.Seconds:00}.{elapsed.Milliseconds:000}";
    }

    private async Task ExportAsync()
    {
        var export = EvaluationRows.Where(row => row.Result is not null || row.Error is not null).Select(row => new
        {
            row.Question.Sheet, row.Question.Row, row.Question.Question,
            row.Question.Scope, row.Question.ScopeSource, row.Question.ExpectedAgent,
            row.Result, row.Error, row.Comparison,
            ModelElapsedMilliseconds = row.Result?.ElapsedMilliseconds ?? entries.GetValueOrDefault(row.Question.Id)?.ModelElapsedMilliseconds
        });
        await JS.InvokeVoidAsync("decisionLab.download", "decision-risultati.json",
            JsonSerializer.Serialize(export, new JsonSerializerOptions(JsonSerializerDefaults.Web) { WriteIndented = true }));
    }

    private static string ShortName(string id) => id switch
    {
        "informativo" => "Informativo", "crm" => "CRM", "scuola" => "Scuola",
        "anagrafe" => "Anagrafe", "tva" => "TVA", _ => id
    };

    private static bool IsExpected(Exception ex) =>
        ex is SimulatorApiException or HttpRequestException or JsonException or IOException or TaskCanceledException;

    private void ShowError(Exception ex)
    {
        Logger.LogWarning("Errore simulatore: {ErrorType}", ex.GetType().Name);
        error = ex is SimulatorApiException ? ex.Message : "Comunicazione con l'API fallita. Verificare che il servizio Aspire sia avviato.";
    }

    public void Dispose()
    {
        lifetime.Cancel();
        lifetime.Dispose();
    }

    private sealed record Entry(RoutingResult? Result, string? Error, long? ModelElapsedMilliseconds = null);
}
